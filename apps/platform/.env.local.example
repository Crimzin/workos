NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Required for 1.11 Inline AI in Posts (@Claude in card/stack threads)
ANTHROPIC_API_KEY=sk-ant-...

# Required for private cloud deployments.
# Local dev stays open if WORKOS_ACCESS_PASSWORD is unset.
WORKOS_ACCESS_USER=will
WORKOS_ACCESS_PASSWORD=replace-with-a-long-private-password

# Required for the Vercel heartbeat cron route.
CRON_SECRET=replace-with-a-long-random-secret
